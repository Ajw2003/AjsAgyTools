{
  "agy-house-rules": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./plugins/agy-house-rules/scripts/hook.py PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python ./plugins/agy-house-rules/scripts/hook.py PostToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python ./plugins/agy-house-rules/scripts/hook.py PreInvocation",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ./plugins/agy-house-rules/scripts/hook.py Stop",
        "timeout": 15
      }
    ]
  }
}
